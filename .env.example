# UniPile API Configuration
# Get these from: https://dashboard.unipile.com/access-tokens

UNIPILE_DSN=your-dsn.unipile.com
UNIPILE_ACCESS_TOKEN=your_access_token_here
UNIPILE_ACCOUNT_ID=your_account_id_here

# AI Response Generation
# Get ANTHROPIC_API_KEY from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-4-sonnet-20250514

# Logging
LOG_LEVEL=INFO
